{
  "$description": "Luma Design System — foundation tokens in W3C DTCG format (Design Tokens Format Module). sRGB hex values mirror the canonical OKLCH definitions in DESIGN.md, provided here for interoperability with tools and registries that ingest tokens.json directly (Stitch, Cursor, v0, Style Dictionary, Tokens Studio). DESIGN.md is the source of truth; if the two ever disagree, DESIGN.md wins. This file covers the foundation layer only — component-token bindings live in registry.json.",
  "$extensions": {
    "com.luma": {
      "version": "1.3.0",
      "source": "DESIGN.md (YAML front matter)",
      "colorScience": "OKLCH",
      "license": "CC BY-NC-ND 4.0",
      "author": "Muhammad Imran (https://imran.fi)"
    }
  },

  "color": {
    "$type": "color",
    "$description": "Semantic color roles. Dark-mode variants live alongside their light counterparts (canvas/canvas-dark); the runtime swaps them in a single .dark {} block.",

    "canvas":         { "$value": "#ffffff", "$description": "Page background — light mode" },
    "surface-1":      { "$value": "#f9f9fb", "$description": "Subtle surface — sidebars, recessed sections" },
    "surface-2":      { "$value": "#f2f2f5", "$description": "UI element default background" },
    "surface-hover":  { "$value": "#e8e8ed", "$description": "UI element hover" },
    "surface-active": { "$value": "#d5d5dc", "$description": "UI element pressed / selected" },

    "canvas-dark":         { "$value": "#0f1115", "$description": "Page background — dark mode (luma-neutral-900)" },
    "surface-dark-1":      { "$value": "#16191c", "$description": "Subtle dark surface (luma-neutral-850)" },
    "surface-dark-2":      { "$value": "#1e2226", "$description": "Card / default element — dark (luma-neutral-800)" },
    "surface-dark-hover":  { "$value": "#282c30", "$description": "Hover / popover — dark (luma-neutral-750)" },
    "surface-dark-active": { "$value": "#32373b", "$description": "Pressed / selected — dark (luma-neutral-700)" },

    "ink":          { "$value": "#0f0f16", "$description": "Highest contrast text (fg-strong)" },
    "ink-body":     { "$value": "#181820", "$description": "Default body text" },
    "ink-muted":    { "$value": "#55556b", "$description": "Secondary / helper text (fg-muted)" },
    "ink-subtle":   { "$value": "#71717e", "$description": "Placeholders, tertiary (fg-subtle)" },
    "ink-disabled": { "$value": "#a4a4b0", "$description": "Disabled controls (fg-disabled)" },

    "hairline":        { "$value": "#e8e8ed", "$description": "Default dividers and outlines" },
    "hairline-strong": { "$value": "#d5d5dc", "$description": "Emphasis borders, active state" },
    "hairline-subtle": { "$value": "#f2f2f5", "$description": "Faint separators" },

    "primary":          { "$value": "#0060d4", "$description": "Electric blue (hue 254). Primary CTA, focus ring, active nav, selected rows. Never decorative." },
    "primary-hover":    { "$value": "#1472e8", "$description": "Lighter — hover state" },
    "primary-pressed":  { "$value": "#004fb8", "$description": "Darker — pressed / active" },
    "primary-disabled": { "$value": "#8db8ef", "$description": "Desaturated — disabled CTA bg" },
    "primary-ring":     { "$value": "#0060d44d", "$description": "Focus halo — rgba(0,96,212,0.30)" },
    "on-primary":       { "$value": "#ffffff", "$description": "Text on primary background" },
    "primary-subtle":   { "$value": "#eef2ff", "$description": "Barely tinted surface — selected rows, active nav" },
    "primary-muted":    { "$value": "#dce8ff", "$description": "Light tint — badges, active item highlights" },
    "primary-dark":     { "$value": "#5393f5", "$description": "Dark-mode primary (brand-400, lighter to read on dark canvas)" },
    "on-primary-dark":  { "$value": "#0f0f16", "$description": "Text on primary — dark mode" },

    "success":        { "$value": "#169a45", "$description": "Vibrant green (hue 145)" },
    "success-bg":     { "$value": "#edfcf2", "$description": "Success tinted background" },
    "success-border": { "$value": "#6ed49a", "$description": "Success container border" },
    "success-text":   { "$value": "#155c2b", "$description": "Success body copy" },
    "on-success":     { "$value": "#ffffff", "$description": "Text on solid success" },

    "warning":        { "$value": "#f4ad0a", "$description": "Vibrant amber (hue 72)" },
    "warning-bg":     { "$value": "#fffbeb", "$description": "Warning tinted background" },
    "warning-border": { "$value": "#fcd35a", "$description": "Warning container border" },
    "warning-text":   { "$value": "#854d0e", "$description": "Warning body copy" },
    "on-warning":     { "$value": "#111111", "$description": "Near-black text on amber — white fails WCAG AA" },

    "error":        { "$value": "#e03131", "$description": "Vibrant red (hue 25) — validation states" },
    "error-bg":     { "$value": "#fff0f0", "$description": "Error tinted background" },
    "error-border": { "$value": "#f5a0a0", "$description": "Error container border" },
    "error-text":   { "$value": "#8b1b1b", "$description": "Error body copy" },
    "on-error":     { "$value": "#ffffff", "$description": "Text on solid error" },

    "info":        { "$value": "#3b7ef4", "$description": "Vivid blue (hue 240) — slightly shifted from primary" },
    "info-bg":     { "$value": "#eff6ff", "$description": "Info tinted background" },
    "info-border": { "$value": "#93bbfc", "$description": "Info container border" },
    "info-text":   { "$value": "#1d4db5", "$description": "Info body copy" },
    "on-info":     { "$value": "#ffffff", "$description": "Text on solid info" },

    "destructive":       { "$value": "#e03131", "$description": "Irreversible action buttons (delete, revoke). Same red as error; intent differs." },
    "destructive-hover": { "$value": "#c02020", "$description": "Destructive hover — darker red" },
    "on-destructive":    { "$value": "#ffffff", "$description": "Text on destructive" },

    "inverse-canvas": { "$value": "#0a0a0a", "$description": "Dark panel on a light page" },
    "inverse-ink":    { "$value": "#f9f9fb", "$description": "Text on inverse canvas" },
    "overlay-bg":     { "$value": "#00000080", "$description": "Shared backdrop — Dialog, Sheet, Drawer. rgba(0,0,0,0.50); dark mode 0.65." }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px base grid. Aliases map 1:1 to the CSS --luma-space-* scale. 12px has no t-shirt alias by design.",
    "xs":      { "$value": "4px" },
    "sm":      { "$value": "8px" },
    "md":      { "$value": "16px" },
    "lg":      { "$value": "24px" },
    "xl":      { "$value": "32px" },
    "2xl":     { "$value": "48px" },
    "3xl":     { "$value": "64px" },
    "section": { "$value": "96px", "$description": "Page-level vertical rhythm between major sections" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Vercel-standard radius scale. 6px (md) is the default for all interactive components.",
    "none": { "$value": "0px" },
    "xs":   { "$value": "2px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "6px", "$description": "Default — Button, Input, Badge, Select, Combobox, Checkbox" },
    "lg":   { "$value": "8px", "$description": "Alert, Note, dropdown menus, Skeleton, Toast" },
    "xl":   { "$value": "12px", "$description": "Card, Dialog, Sheet" },
    "2xl":  { "$value": "16px" },
    "3xl":  { "$value": "24px" },
    "pill": { "$value": "9999px", "$description": "Avatar, StatusDot, pill badges, toggle thumbs" }
  },

  "fontFamily": {
    "$type": "fontFamily",
    "sans": { "$value": ["Geist", "Inter", "system-ui", "sans-serif"], "$description": "UI sans — Geist with Inter fallback" },
    "mono": { "$value": ["Geist Mono", "JetBrains Mono", "Fira Code", "Cascadia Code", "monospace"], "$description": "Code, tokens, IDs, keyboard shortcuts" }
  },

  "typography": {
    "$type": "typography",
    "$description": "10 named roles bundling family + size + weight + leading + tracking. Always reach for these before raw sizes.",
    "display":        { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "40px", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "-0.05em" }, "$description": "Hero headlines, marketing" },
    "heading":        { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "-0.025em" }, "$description": "Page headings (h1)" },
    "title":          { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "-0.025em" }, "$description": "Section headings (h2)" },
    "subtitle":       { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.375, "letterSpacing": "0" }, "$description": "Supporting headings, card titles (h3)" },
    "body-lg":        { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "18px", "fontWeight": 500, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Emphasis paragraphs, intro copy" },
    "body":           { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Default body copy" },
    "body-sm":        { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Secondary content — table cells, timestamps, descriptions" },
    "body-sm-strong": { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Component default — Button, Badge, Input labels, nav items" },
    "caption":        { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Helper text, metadata" },
    "label":          { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.25, "letterSpacing": "0.1em" }, "$description": "Section labels — wide tracking" },
    "eyebrow":        { "$value": { "fontFamily": ["Geist", "Inter", "system-ui", "sans-serif"], "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.25, "letterSpacing": "0.08em" }, "$description": "Uppercase pattern — table column headers, category tags", "$extensions": { "com.luma": { "textTransform": "uppercase" } } },
    "mono":           { "$value": { "fontFamily": ["Geist Mono", "JetBrains Mono", "Fira Code", "Cascadia Code", "monospace"], "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Code, token names, IDs, keyboard shortcuts, fixed-width data" }
  },

  "duration": {
    "$type": "duration",
    "instant": { "$value": "75ms",  "$description": "Micro-feedback — checkbox tick, ripple" },
    "fast":    { "$value": "150ms", "$description": "Hover states, small transitions" },
    "normal":  { "$value": "250ms", "$description": "Standard default — most UI state changes" },
    "slow":    { "$value": "400ms", "$description": "Panels, sidebars, larger layout shifts" },
    "slower":  { "$value": "600ms", "$description": "Page-level transitions, skeleton shimmer" },
    "spring":  { "$value": "300ms", "$description": "Snappy enter — dialogs, drawers, dropdowns" },
    "bounce":  { "$value": "400ms", "$description": "Playful elements — badges, status dots" }
  },

  "easing": {
    "$type": "cubicBezier",
    "out":    { "$value": [0, 0, 0.2, 1], "$description": "Default ease-out — hover, standard transitions" },
    "spring": { "$value": [0.16, 1, 0.3, 1], "$description": "Snappy enter" },
    "bounce": { "$value": [0.34, 1.56, 0.64, 1], "$description": "Playful overshoot" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Light-mode elevation ladder. Filled buttons get NO shadow. Dark mode replaces blur with a white hairline ring (see DESIGN.md elevation.dark-note).",
    "xs": { "$value": [
      { "color": "#0000000d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    ], "$description": "Bordered / outline controls" },
    "sm": { "$value": [
      { "color": "#00000014", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
      { "color": "#0000000a", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    ], "$description": "Content containers — Card, Slider thumb" },
    "md": { "$value": [
      { "color": "#00000014", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" },
      { "color": "#0000000a", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" }
    ], "$description": "Panels floating above page — Popover, Dropdown, HoverCard" },
    "lg": { "$value": [
      { "color": "#0000001f", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" },
      { "color": "#0000000d", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" }
    ], "$description": "Full overlays — Dialog, Sheet, Toast" },
    "xl": { "$value": [
      { "color": "#00000024", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" },
      { "color": "#00000014", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }
    ], "$description": "Highest priority floating — Command palette, chart tooltips" },
    "2xl": { "$value": [
      { "color": "#0000002e", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px" },
      { "color": "#0000001a", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }
    ], "$description": "Maximum elevation" }
  },

  "zIndex": {
    "$type": "number",
    "base":     { "$value": 0,   "$description": "Normal document flow" },
    "raised":   { "$value": 10,  "$description": "Sticky headers, floating action buttons" },
    "dropdown": { "$value": 100, "$description": "Menus, popovers, combobox lists" },
    "sticky":   { "$value": 200, "$description": "Sticky nav bar, sticky table headers" },
    "overlay":  { "$value": 300, "$description": "Dialog / sheet / drawer backdrop" },
    "modal":    { "$value": 400, "$description": "Dialogs, sheets, drawers" },
    "toast":    { "$value": 500, "$description": "Always above modals" },
    "tooltip":  { "$value": 600, "$description": "Always topmost" }
  }
}
